{
  "name": "tienda-fg",
  "version": "6.0.0",
  "description": "Tienda online multi-tienda con Supabase — Seguridad blindada 6 capas + Cluster multi-server",
  "main": "cluster.js",
  "type": "module",
  "scripts": {
    "start": "node cluster.js",
    "single": "node server.js",
    "dev": "node --watch server.js",
    "pm2": "pm2 start ecosystem.config.json",
    "pm2:stop": "pm2 stop tienda-fg",
    "pm2:restart": "pm2 restart tienda-fg",
    "pm2:logs": "pm2 logs tienda-fg",
    "pm2:scale": "pm2 scale tienda-fg +2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
